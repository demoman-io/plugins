{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use.sh\" 0.9.3",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__.*github.*__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use.sh\" 0.9.3",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
